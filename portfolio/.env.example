GROQ_API_KEY=your_groq_api_key_here

# Admin dashboard login (pick your own password)
ADMIN_PASSWORD=your_admin_password_here
# Random signing secret for the login session cookie (any long random string)
SESSION_SECRET=your_random_session_secret_here

# Auto-added by Vercel once you connect a Postgres database
# (Storage tab in your Vercel project -> Create Database -> Postgres)
POSTGRES_URL=
