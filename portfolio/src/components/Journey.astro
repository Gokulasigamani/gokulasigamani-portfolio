---
import { getImage } from 'astro:assets';
import { journeyIntro, journeySteps, journeyPlan } from '../data/experience';
import trackRecordImage from '../assets/images/third.png';
import graduationImage from '../assets/images/IMG_5890.jpg';

const optimizedTrackRecord = await getImage({ src: trackRecordImage, width: 900, format: 'webp', quality: 75 });
const optimizedGraduation = await getImage({ src: graduationImage, width: 1100, format: 'webp', quality: 82 });
---

<section class="mx-auto max-w-[1440px] px-4 py-16 sm:px-8 sm:py-20 lg:px-12">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
    <div class="relative overflow-hidden">
      <div
        class="aspect-[4/3] w-full bg-cover bg-center"
        style={`background-image: url('${optimizedTrackRecord.src}'); background-position: 50% 50%;`}
      >
      </div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
      <p class="absolute bottom-4 left-4 font-body text-[11px] font-medium tracking-[0.1em] text-white">
        {journeyIntro.imageCaption}
      </p>
    </div>

    <div>
      <p class="font-body text-xs font-medium tracking-[0.15em] text-neutral-400">{journeyIntro.eyebrow}</p>
      <h2 class="mt-3 font-heading text-[clamp(1.75rem,3.5vw,2.5rem)] font-medium leading-tight text-neutral-900">
        <span class="block">{journeyIntro.heading[0]}</span>
        <span class="block">{journeyIntro.heading[1]}</span>
      </h2>

      <div class="mt-8 divide-y divide-neutral-200 border-t border-neutral-200">
        {journeySteps.map((step) => (
          <div class="flex items-start gap-4 py-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center border border-neutral-200 text-neutral-700">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
            </span>
            <div>
              <p class="font-body text-[11px] font-medium tracking-[0.1em] text-neutral-400">
                {step.label}
              </p>
              <h3 class="mt-1.5 font-heading text-lg font-medium text-neutral-900">{step.title}</h3>
              <p class="mt-1 font-body text-sm text-neutral-500">{step.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-1 lg:grid-cols-[2fr_3fr]">
    <div class="flex flex-col gap-4 bg-[#F1DACB] p-8 sm:p-10">
      <p class="font-body text-[11px] font-medium tracking-[0.1em] text-[#8A5A3C]">{journeyPlan.eyebrow}</p>
      <div class="relative aspect-square w-full overflow-hidden">
        <div
          class="h-full w-full bg-cover bg-center"
          style={`background-image: url('${optimizedGraduation.src}'); background-position: 50% 20%;`}
        >
        </div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
        <p class="absolute bottom-3 left-3 font-body text-[11px] font-medium tracking-[0.1em] text-white">
          {journeyPlan.imageLabel}
        </p>
      </div>
    </div>

    <div class="bg-white p-8 sm:p-10">
      <h3 class="font-heading text-2xl font-medium leading-tight text-neutral-900 sm:text-3xl">
        <span class="block">{journeyPlan.rightHeading[0]}</span>
        <span class="block">{journeyPlan.rightHeading[1]}</span>
      </h3>
      <p class="mt-4 max-w-md font-body text-sm leading-relaxed text-neutral-500">
        {journeyPlan.body}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-body text-[11px] font-medium tracking-[0.08em] text-neutral-400">
        {journeyPlan.tags.map((tag, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            <span>{tag}</span>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
