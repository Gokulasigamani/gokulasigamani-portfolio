---
import { getPublishedPosts } from '../lib/db';
import { estimateReadingTime, formatPostDate } from '../utils/reading-time';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
---

{posts.length > 0 && (
  <section id="blog" class="mx-auto max-w-[1440px] px-4 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-body text-xs font-medium tracking-[0.15em] text-neutral-400">11 / FROM THE BLOG</p>
        <h2 class="mt-3 font-heading text-[clamp(1.75rem,4vw,2.5rem)] font-medium leading-tight text-neutral-900">
          Notes on building things.
        </h2>
      </div>
      <a href="/blog" class="inline-flex items-center gap-1.5 font-body text-sm font-medium text-neutral-600 transition-colors hover:text-neutral-900">
        View all posts
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group flex flex-col border border-neutral-200 transition-colors hover:border-neutral-400">
          <div class="aspect-[16/10] w-full overflow-hidden">
            <img
              src={post.cover_image}
              alt={post.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <div class="flex flex-1 flex-col p-4">
            <p class="font-body text-[11px] font-medium tracking-[0.1em] text-neutral-400">
              {formatPostDate(new Date(post.published_at ?? post.created_at))} · {estimateReadingTime(post.body)} min read
            </p>
            <h3 class="mt-2 font-heading text-base font-medium leading-snug text-neutral-900">
              {post.title}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
