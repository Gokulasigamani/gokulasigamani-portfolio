---
import { chatWidget } from '../data/experience';
---

<div id="chat-scrim" class="fixed inset-0 z-[55] bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 sm:hidden"></div>

<div id="chat-widget-root" class="fixed bottom-[76px] right-6 z-[65] flex flex-col items-end sm:bottom-[92px] sm:right-8">
  <div
    id="chat-panel"
    class="ai-border fixed inset-x-3 bottom-3 z-[60] flex h-[72dvh] max-h-[560px] origin-bottom scale-95 flex-col overflow-hidden border border-white/40 opacity-0 shadow-2xl transition-all duration-200 ease-out pointer-events-none sm:static sm:z-auto sm:mb-3 sm:inset-x-auto sm:bottom-auto sm:h-auto sm:w-[360px] sm:max-h-none sm:origin-bottom-right"
  >
    <div class="pointer-events-none absolute -left-10 -top-10 h-40 w-40 bg-[#E3A17E] opacity-40 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-16 -right-10 h-44 w-44 bg-[#8A6FB0] opacity-30 blur-3xl"></div>
    <div class="pointer-events-none absolute right-1/3 top-1/2 h-32 w-32 bg-[#C9A8C4] opacity-30 blur-3xl"></div>

    <div class="relative flex shrink-0 items-center justify-between border-b border-white/30 bg-[#241B26]/60 px-4 py-4 backdrop-blur-xl">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center border border-white/30 bg-white/10 font-heading text-xs font-semibold text-[#E3A17E] backdrop-blur-sm">
          G
        </span>
        <div>
          <p class="font-heading text-sm font-medium text-white">{chatWidget.name}</p>
          <p class="flex items-center gap-1.5 font-body text-[11px] text-white/60">
            <span class="h-1.5 w-1.5 shrink-0 bg-emerald-400"></span>
            {chatWidget.status}
          </p>
        </div>
      </div>
      <button id="chat-close" type="button" aria-label="Close chat" class="flex h-8 w-8 shrink-0 items-center justify-center text-white/60 transition-colors hover:bg-white/10 hover:text-white">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <div id="chat-messages" class="relative min-h-0 flex-1 space-y-3 overflow-y-auto bg-white/10 px-4 py-4 backdrop-blur-xl sm:flex-none sm:max-h-80">
      <div class="flex items-start gap-2.5">
        <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center border border-white/40 bg-white/30 font-heading text-[10px] font-semibold text-[#8A5A3C] backdrop-blur-sm">
          G
        </span>
        <p class="max-w-[80%] border border-white/50 bg-white/60 px-3.5 py-2.5 font-body text-sm leading-relaxed text-neutral-800 shadow-sm backdrop-blur-md">
          {chatWidget.greeting}
        </p>
      </div>

      <div id="chat-quick-links" class="flex flex-wrap gap-2 pl-[38px]">
        {chatWidget.quickLinks.map((link) => (
          <a
            href={link.href}
            class="border border-white/50 bg-white/30 px-3.5 py-1.5 font-body text-xs font-medium text-neutral-800 backdrop-blur-sm transition-colors hover:bg-white/50"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <form id="chat-form" class="relative flex shrink-0 items-center gap-2 border-t border-white/30 bg-white/20 p-3 backdrop-blur-xl" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
      <div class="ai-border relative min-w-0 flex-1">
        <input
          type="text"
          name="message"
          placeholder={chatWidget.placeholder}
          autocomplete="off"
          required
          class="w-full border border-white/40 bg-white/40 px-4 py-2.5 font-body text-sm text-neutral-900 placeholder:text-neutral-500 backdrop-blur-sm focus:border-white/70 focus:bg-white/60 focus:outline-none"
        />
      </div>
      <button
        id="chat-mic"
        type="button"
        aria-label="Speak your message"
        class="ai-border relative flex h-10 w-10 shrink-0 items-center justify-center border border-white/40 bg-white/30 text-neutral-700 backdrop-blur-sm transition-colors hover:bg-white/50"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Z" />
          <path d="M19 11a7 7 0 0 1-14 0" />
          <path d="M12 18v3" />
        </svg>
      </button>
      <button
        type="submit"
        aria-label="Send message"
        class="ai-border relative flex h-10 w-10 shrink-0 items-center justify-center border border-white/20 bg-[#241B26]/90 text-white backdrop-blur-sm transition-colors hover:bg-[#241B26]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>
  </div>

  <button
    id="chat-toggle"
    type="button"
    aria-label="Open Gokul AI chat"
    aria-expanded="false"
    class="ai-border relative flex h-12 w-12 cursor-pointer items-center justify-center border border-white/30 bg-[#241B26]/75 text-white shadow-lg backdrop-blur-md transition-all duration-300 hover:border-white/50 hover:bg-[#241B26]/90 active:scale-95"
  >
    <svg id="chat-icon-open" viewBox="0 0 24 24" class="h-4 w-4 text-[#E3A17E]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 5h16v10H8l-4 4V5Z" />
    </svg>
    <svg id="chat-icon-close" viewBox="0 0 24 24" class="absolute inset-0 m-auto h-4 w-4 opacity-0 transition-opacity duration-200" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>
</div>

<style>
  @property --chat-border-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .ai-border {
    --chat-border-angle: 0deg;
  }

  .ai-border::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 20;
    padding: 2.5px;
    background: conic-gradient(
      from var(--chat-border-angle),
      #e3a17e,
      #c9a8c4,
      #8a6fb0,
      #e3a17e
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    animation: chat-border-rotate 4s linear infinite;
  }

  @keyframes chat-border-rotate {
    to {
      --chat-border-angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-border::before {
      animation: none;
    }
  }

  @media (max-width: 639px) {
    #chat-panel {
      transform: translateY(100%);
    }

    #chat-panel:not(.scale-95) {
      transform: translateY(0);
    }

    #chat-widget-root.chat-open #chat-toggle {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.85);
    }
  }

  #chat-messages {
    scrollbar-width: thin;
    scrollbar-color: rgba(138, 90, 60, 0.35) transparent;
  }

  #chat-messages::-webkit-scrollbar {
    width: 3px;
  }

  #chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }

  #chat-messages::-webkit-scrollbar-thumb {
    background: rgba(138, 90, 60, 0.35);
  }

  #chat-mic.mic-listening {
    background-color: rgba(239, 68, 68, 0.85);
    color: white;
    animation: mic-pulse 1.2s ease-in-out infinite;
  }

  @keyframes mic-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #chat-mic.mic-listening {
      animation: none;
    }
  }
</style>

<style is:global>
  .chat-content p {
    margin: 0;
  }

  .chat-content p + p {
    margin-top: 0.5em;
  }

  .chat-content ul,
  .chat-content ol {
    margin: 0.4em 0 0;
    padding-left: 1.1em;
  }

  .chat-content ul {
    list-style: disc;
  }

  .chat-content ol {
    list-style: decimal;
  }

  .chat-content li + li {
    margin-top: 0.2em;
  }

  .chat-content strong {
    font-weight: 700;
  }

  .chat-content a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  import { marked } from 'marked';

  marked.setOptions({ breaks: true });

  type ChatMessage = { role: 'user' | 'assistant'; content: string };

  const NAV_VERB = /\b(navigate|take me|go to|show me|open|visit|bring me)\b/i;
  const NAV_INTENTS: { path: string; label: string; keywords: RegExp }[] = [
    { path: '/blog', label: 'the blog', keywords: /\bblog\b/i },
    { path: '/#experience', label: 'the experience section', keywords: /\b(experience|work history|career)\b/i },
    { path: '/#achievements', label: 'achievements', keywords: /\b(achievements?|awards?|certifications?)\b/i },
    { path: '/#about', label: 'the about section', keywords: /\babout\b/i },
    { path: '/contact', label: 'the contact page', keywords: /\b(contact|get in touch|reach out|touch)\b/i },
    { path: '/', label: 'the home page', keywords: /\bhome\b/i }
  ];

  function detectNavigation(message: string): { path: string; label: string } | null {
    if (!NAV_VERB.test(message)) return null;
    for (const intent of NAV_INTENTS) {
      if (intent.keywords.test(message)) return intent;
    }
    return null;
  }

  const root = document.getElementById('chat-widget-root');
  const toggle = document.getElementById('chat-toggle');
  const panel = document.getElementById('chat-panel');
  const scrim = document.getElementById('chat-scrim');
  const closeBtn = document.getElementById('chat-close');
  const iconOpen = document.getElementById('chat-icon-open');
  const iconClose = document.getElementById('chat-icon-close');
  const form = document.getElementById('chat-form') as HTMLFormElement | null;
  const messagesEl = document.getElementById('chat-messages');
  const quickLinksEl = document.getElementById('chat-quick-links');
  const micBtn = document.getElementById('chat-mic');
  const input = form?.querySelector('input[name="message"]') as HTMLInputElement | null;
  const originalPlaceholder = input?.placeholder ?? '';

  const history: ChatMessage[] = [];
  const isMobile = () => window.matchMedia('(max-width: 639px)').matches;
  let voiceInitiatedTurn = false;

  function stripMarkdownForSpeech(text: string) {
    return text
      .replace(/\*\*(.*?)\*\*/g, '$1')
      .replace(/\*(.*?)\*/g, '$1')
      .replace(/`{1,3}([^`]*)`{1,3}/g, '$1')
      .replace(/\[(.*?)\]\(.*?\)/g, '$1')
      .replace(/^#{1,6}\s*/gm, '')
      .replace(/^[-*]\s+/gm, '')
      .trim();
  }

  const SpeechRecognitionCtor =
    (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  const supportsSpeech = Boolean(SpeechRecognitionCtor) && 'speechSynthesis' in window;
  let recognition: any = null;

  function speak(text: string) {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(stripMarkdownForSpeech(text));
    utterance.lang = recognition?.lang || navigator.language || 'en-US';
    window.speechSynthesis.speak(utterance);
  }

  function stopVoice() {
    window.speechSynthesis?.cancel();
    try {
      recognition?.stop();
    } catch {
      // ignore
    }
  }

  if (!supportsSpeech) {
    micBtn?.remove();
  } else {
    recognition = new SpeechRecognitionCtor();
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;

    const setListening = (listening: boolean) => {
      micBtn?.classList.toggle('mic-listening', listening);
      if (input) input.placeholder = listening ? 'Listening...' : originalPlaceholder;
    };

    micBtn?.addEventListener('click', () => {
      if (micBtn.classList.contains('mic-listening')) {
        recognition.stop();
        return;
      }
      window.speechSynthesis?.cancel();
      try {
        recognition.lang = navigator.language || 'en-US';
        recognition.start();
        setListening(true);
      } catch {
        setListening(false);
      }
    });

    recognition.addEventListener('result', (event: any) => {
      const transcript = event.results?.[0]?.[0]?.transcript?.trim();
      if (transcript && input && form) {
        voiceInitiatedTurn = true;
        input.value = transcript;
        form.requestSubmit();
      }
    });

    recognition.addEventListener('end', () => setListening(false));
    recognition.addEventListener('error', () => setListening(false));
  }

  function setOpen(open: boolean) {
    if (!panel || !toggle) return;
    panel.classList.toggle('opacity-0', !open);
    panel.classList.toggle('scale-95', !open);
    panel.classList.toggle('pointer-events-none', !open);
    scrim?.classList.toggle('opacity-0', !open);
    scrim?.classList.toggle('pointer-events-none', !open);
    root?.classList.toggle('chat-open', open);
    iconOpen?.classList.toggle('opacity-0', open);
    iconClose?.classList.toggle('opacity-0', !open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('overflow-hidden', open && isMobile());
    if (!open && panel) panel.style.bottom = '';
    if (!open) stopVoice();
  }

  function syncKeyboardInset() {
    if (!panel || !window.visualViewport || !isMobile()) return;
    const vv = window.visualViewport;
    const keyboardInset = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
    panel.style.bottom = keyboardInset > 0 ? `${keyboardInset + 12}px` : '';
  }

  window.visualViewport?.addEventListener('resize', syncKeyboardInset);
  window.visualViewport?.addEventListener('scroll', syncKeyboardInset);

  toggle?.addEventListener('click', () => {
    setOpen(panel?.classList.contains('opacity-0') ?? true);
  });

  closeBtn?.addEventListener('click', () => setOpen(false));
  scrim?.addEventListener('click', () => setOpen(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !panel?.classList.contains('opacity-0')) setOpen(false);
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (!panel || panel.classList.contains('opacity-0') || isMobile()) return;
    if (!panel.contains(target) && !toggle?.contains(target)) {
      setOpen(false);
    }
  });

  function scrollToBottom() {
    if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addMessage(role: 'user' | 'assistant', content: string) {
    if (!messagesEl) return;
    const wrapper = document.createElement('div');
    wrapper.className = role === 'user' ? 'relative flex justify-end' : 'relative flex items-start gap-2.5';

    if (role === 'assistant') {
      const avatar = document.createElement('span');
      avatar.className =
        'mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center border border-white/40 bg-white/30 font-heading text-[10px] font-semibold text-[#8A5A3C] backdrop-blur-sm';
      avatar.textContent = 'G';
      wrapper.appendChild(avatar);
    }

    const bubble = document.createElement('div');
    bubble.className =
      role === 'user'
        ? 'max-w-[80%] border border-white/20 bg-[#241B26]/80 px-3.5 py-2.5 font-body text-sm leading-relaxed text-white backdrop-blur-md'
        : 'chat-content max-w-[80%] border border-white/50 bg-white/60 px-3.5 py-2.5 font-body text-sm leading-relaxed text-neutral-800 shadow-sm backdrop-blur-md';

    if (role === 'assistant') {
      bubble.innerHTML = marked.parse(content) as string;
    } else {
      bubble.textContent = content;
    }
    wrapper.appendChild(bubble);

    messagesEl.appendChild(wrapper);
    scrollToBottom();
  }

  function addTyping() {
    if (!messagesEl) return;
    const wrapper = document.createElement('div');
    wrapper.id = 'chat-typing';
    wrapper.className = 'flex items-start gap-2.5';
    wrapper.innerHTML = `
      <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center border border-white/40 bg-white/30 font-heading text-[10px] font-semibold text-[#8A5A3C] backdrop-blur-sm">G</span>
      <span class="flex items-center gap-1 border border-white/50 bg-white/60 px-3.5 py-3 shadow-sm backdrop-blur-md">
        <span class="h-1.5 w-1.5 animate-bounce bg-neutral-500" style="animation-delay:0ms"></span>
        <span class="h-1.5 w-1.5 animate-bounce bg-neutral-500" style="animation-delay:150ms"></span>
        <span class="h-1.5 w-1.5 animate-bounce bg-neutral-500" style="animation-delay:300ms"></span>
      </span>
    `;
    messagesEl.appendChild(wrapper);
    scrollToBottom();
  }

  function removeTyping() {
    document.getElementById('chat-typing')?.remove();
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const message = input?.value.trim();
    if (!message || !input) return;

    const isVoiceTurn = voiceInitiatedTurn;
    voiceInitiatedTurn = false;

    quickLinksEl?.classList.add('hidden');
    addMessage('user', message);
    input.value = '';

    const navIntent = detectNavigation(message);
    if (navIntent) {
      const navReply = `Heading to ${navIntent.label} now.`;
      addMessage('assistant', navReply);
      if (isVoiceTurn) speak(navReply);
      input.disabled = true;
      setTimeout(() => {
        window.location.href = navIntent.path;
      }, 700);
      return;
    }

    history.push({ role: 'user', content: message });
    input.disabled = true;
    addTyping();

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history })
      });
      const data = await res.json();
      removeTyping();

      if (!res.ok) {
        const errorReply = data.error || 'Something went wrong. Please try again.';
        addMessage('assistant', errorReply);
        if (isVoiceTurn) speak(errorReply);
      } else {
        addMessage('assistant', data.reply);
        if (isVoiceTurn) speak(data.reply);
        history.push({ role: 'assistant', content: data.reply });
      }
    } catch {
      removeTyping();
      const failureReply = 'Something went wrong connecting to the assistant. Please try again or use the contact page.';
      addMessage('assistant', failureReply);
      if (isVoiceTurn) speak(failureReply);
    } finally {
      input.disabled = false;
      input.focus();
    }
  });
</script>
