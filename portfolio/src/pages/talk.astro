---
import '../styles/global.css';
import { profile } from '../data/experience';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/Gokulasigamani_favicon.png" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Talk to Gokul AI</title>
    <meta name="description" content={`Have a live voice conversation with Gokul AI, ${profile.name}'s AI assistant.`} />
  </head>
  <body class="relative flex min-h-[100dvh] flex-col overflow-hidden bg-[#03040A] text-white">
    <div class="talk-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <a
      href="/"
      aria-label="Back to site"
      class="absolute left-4 z-20 flex h-10 w-10 items-center justify-center rounded-[9999px] border border-white/15 text-white/60 transition-colors hover:border-white/40 hover:text-white"
      style="top: max(1rem, env(safe-area-inset-top, 0px));"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 6l-6 6 6 6" />
      </svg>
    </a>

    <main class="relative z-10 mx-auto flex w-full max-w-sm flex-1 flex-col items-center justify-center gap-10 px-6 pb-44 pt-24 text-center">
      <div id="talk-orb" class="talk-orb relative h-40 w-40 sm:h-48 sm:w-48">
        <span class="talk-orb-glow" aria-hidden="true"></span>
        <span class="talk-orb-core" aria-hidden="true"></span>
      </div>

      <div>
        <p class="font-body text-sm text-white/50">Hi, I&rsquo;m Gokul AI</p>
        <h1 class="mt-3 font-heading text-[clamp(1.75rem,6vw,2.25rem)] font-semibold leading-[1.15] text-white">
          How can I help
          <br />
          you today?
        </h1>
      </div>
    </main>

    <div
      class="relative z-10 w-full px-4"
      style="padding-bottom: max(1.5rem, env(safe-area-inset-bottom, 0px));"
    >
      <div class="mx-auto w-full max-w-sm">
        <button
          id="talk-call"
          type="button"
          aria-label="Start call"
          class="talk-pill flex w-full items-center justify-between gap-3 rounded-[9999px] border border-white/15 bg-white/10 px-6 py-4 text-left backdrop-blur-xl transition-colors"
        >
          <span id="talk-status" class="truncate font-body text-[15px] text-white/70">Tap to start talking</span>
          <span class="talk-pill-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-[9999px] bg-white/10 text-white/80 transition-colors">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="4" y1="10" x2="4" y2="14" />
              <line x1="8" y1="7" x2="8" y2="17" />
              <line x1="12" y1="4" x2="12" y2="20" />
              <line x1="16" y1="7" x2="16" y2="17" />
              <line x1="20" y1="10" x2="20" y2="14" />
            </svg>
          </span>
        </button>

        <p id="talk-fallback" hidden class="mt-4 text-center font-body text-xs text-white/40">
          Voice calls need a browser that supports speech recognition, like Chrome or Edge. Try opening this page there.
        </p>
      </div>
    </div>

    <audio id="talk-audio" playsinline></audio>

    <style>
      .talk-bg {
        background:
          radial-gradient(60% 46% at 50% 112%, rgba(37, 99, 235, 0.65) 0%, rgba(20, 58, 163, 0.32) 40%, rgba(3, 4, 10, 0) 72%),
          radial-gradient(85% 55% at 50% 6%, rgba(9, 14, 28, 0.9) 0%, rgba(3, 4, 10, 1) 58%),
          #03040a;
      }

      @property --talk-orb-angle {
        syntax: '<angle>';
        initial-value: 0deg;
        inherits: false;
      }

      .talk-orb {
        --talk-orb-angle: 0deg;
        --talk-orb-glow-opacity: 0.55;
      }

      .talk-orb-glow {
        position: absolute;
        inset: -22%;
        display: block;
        border-radius: 9999px;
        background: radial-gradient(circle at 34% 30%, rgba(255, 255, 255, 0.95), rgba(147, 197, 253, 0.55) 28%, rgba(37, 99, 235, 0.4) 48%, transparent 72%);
        filter: blur(20px);
        opacity: var(--talk-orb-glow-opacity);
        animation: talk-orb-breathe 4.5s ease-in-out infinite;
      }

      .talk-orb-core {
        position: absolute;
        inset: 10%;
        display: block;
        overflow: hidden;
        border-radius: 9999px;
        background: radial-gradient(circle at 38% 34%, #101c33 0%, #050810 55%, #010205 100%);
        box-shadow:
          inset 0 0 34px rgba(59, 130, 246, 0.28),
          0 0 46px rgba(37, 99, 235, 0.4);
      }

      .talk-orb-core::after {
        content: '';
        position: absolute;
        inset: -40%;
        background: conic-gradient(
          from var(--talk-orb-angle),
          transparent 0deg,
          rgba(125, 211, 252, 0.85) 35deg,
          rgba(255, 255, 255, 0.95) 52deg,
          rgba(59, 130, 246, 0.55) 74deg,
          transparent 130deg,
          transparent 360deg
        );
        filter: blur(6px);
        mix-blend-mode: screen;
        animation: talk-orb-rotate 7s linear infinite;
      }

      @keyframes talk-orb-rotate {
        to {
          --talk-orb-angle: 360deg;
        }
      }

      @keyframes talk-orb-breathe {
        0%,
        100% {
          transform: scale(1);
          opacity: var(--talk-orb-glow-opacity);
        }
        50% {
          transform: scale(1.06);
          opacity: calc(var(--talk-orb-glow-opacity) + 0.15);
        }
      }

      .talk-orb.talk-listening {
        --talk-orb-glow-opacity: 0.75;
      }
      .talk-orb.talk-listening .talk-orb-core::after {
        animation-duration: 3.2s;
      }

      .talk-orb.talk-speaking {
        --talk-orb-glow-opacity: 0.9;
      }
      .talk-orb.talk-speaking .talk-orb-core::after {
        animation-duration: 1.8s;
      }

      .talk-pill {
        box-shadow: 0 14px 32px rgba(3, 4, 10, 0.5);
      }
      .talk-pill:hover {
        background-color: rgba(255, 255, 255, 0.14);
      }

      #talk-call.talk-active {
        border-color: rgba(248, 113, 113, 0.4);
        background-color: rgba(127, 29, 29, 0.35);
      }
      #talk-call.talk-active .talk-pill-icon {
        background-color: rgba(248, 113, 113, 0.25);
        color: #fecaca;
      }

      #talk-call[disabled] {
        cursor: not-allowed;
        opacity: 0.45;
      }

      @media (prefers-reduced-motion: reduce) {
        .talk-orb-glow,
        .talk-orb-core::after {
          animation: none;
        }
      }
    </style>

    <script>
      type ChatMessage = { role: 'user' | 'assistant'; content: string };

      const orb = document.getElementById('talk-orb');
      const statusEl = document.getElementById('talk-status');
      const callBtn = document.getElementById('talk-call');
      const fallbackEl = document.getElementById('talk-fallback');
      const audioEl = document.getElementById('talk-audio') as HTMLAudioElement | null;

      const history: ChatMessage[] = [];
      let callActive = false;

      // A tiny, valid, silent WAV clip used only to unlock <audio> playback on
      // mobile Safari - built in code instead of a hand-written base64 blob so
      // there's no risk of shipping a malformed data URI.
      function createSilentAudioUrl(): string {
        const buffer = new ArrayBuffer(45);
        const view = new DataView(buffer);
        const writeString = (offset: number, text: string) => {
          for (let i = 0; i < text.length; i++) view.setUint8(offset + i, text.charCodeAt(i));
        };
        writeString(0, 'RIFF');
        view.setUint32(4, 37, true);
        writeString(8, 'WAVE');
        writeString(12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true);
        view.setUint16(22, 1, true);
        view.setUint32(24, 8000, true);
        view.setUint32(28, 8000, true);
        view.setUint16(32, 1, true);
        view.setUint16(34, 8, true);
        writeString(36, 'data');
        view.setUint32(40, 1, true);
        view.setUint8(44, 128);
        return URL.createObjectURL(new Blob([buffer], { type: 'audio/wav' }));
      }

      // A single fixed RMS threshold assumes every microphone/browser reports the
      // same loudness for normal speech, which isn't true — a quiet laptop mic can
      // sit well under a threshold tuned against a sensitive headset, so speech
      // never gets flagged and the call just silently loops. Instead we measure
      // this device's actual ambient noise floor for a brief moment at the start
      // of each turn and require speech to clear that floor by a margin, so
      // detection adapts to whatever hardware is actually listening.
      const NOISE_SAMPLE_MS = 250;
      const SPEECH_MARGIN_ABOVE_NOISE = 0.012;
      const SPEECH_RMS_MIN_THRESHOLD = 0.012;
      const MIN_SPEECH_MS = 300;
      const SPEECH_GAP_TOLERANCE_MS = 200;
      const SILENCE_MS = 700;
      // If nothing crosses the speech threshold at all within this window, give up
      // and restart listening instead of silently running the full recording cap —
      // keeps a bad reading from feeling like the call is stuck.
      const NO_SPEECH_TIMEOUT_MS = 6000;
      const MAX_RECORD_MS = 20000;
      // Each turn makes up to three sequential requests (transcribe, chat, speak),
      // each with its own connection setup - on a real mobile connection (higher
      // latency, slower upload for the recorded clip) that easily adds up past a
      // tight budget, which was aborting almost every turn and replacing a real
      // reply with the same generic fallback message every time. These are
      // deliberately generous so a slow-but-working connection still gets a real
      // answer; MAX_RECORD_MS above remains the hard ceiling on how long any one
      // turn can run.
      const TRANSCRIBE_TIMEOUT_MS = 25000;
      const CHAT_TIMEOUT_MS = 20000;
      const SPEAK_FETCH_TIMEOUT_MS = 15000;

      // Every network call in the call pipeline goes through this so a slow/stalled
      // Groq response can never hang the call forever — it aborts and the caller's
      // existing error handling takes over instead.
      async function fetchWithTimeout(input: string, init: RequestInit, timeoutMs: number): Promise<Response> {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), timeoutMs);
        try {
          return await fetch(input, { ...init, signal: controller.signal });
        } finally {
          window.clearTimeout(timeout);
        }
      }

      // Groq Whisper hallucinates short stock phrases on silence/noise-only audio
      // (e.g. it transcribes true silence as "Thank you."). Filter those out instead
      // of treating them as a real question.
      const HALLUCINATION_PATTERNS = [
        /^thanks?( you)?[.!]?$/i,
        /^thank you for watching[.!]?$/i,
        /^thanks for watching[.!]?$/i,
        /^please (subscribe|like and subscribe)[.!]?$/i,
        /^(bye|goodbye|see you)[.!]?$/i,
        /^[.,!?\s]*$/
      ];

      function looksHallucinated(transcript: string): boolean {
        const text = transcript.trim();
        if (!text) return true;
        return HALLUCINATION_PATTERNS.some((pattern) => pattern.test(text));
      }

      const supportsCall =
        Boolean(navigator.mediaDevices?.getUserMedia) && typeof MediaRecorder !== 'undefined';

      function setStatus(text: string) {
        if (statusEl) statusEl.textContent = text;
      }

      if (!supportsCall) {
        callBtn?.setAttribute('disabled', 'true');
        fallbackEl?.removeAttribute('hidden');
        setStatus('Voice calls are not supported in this browser.');
      } else {
        let stream: MediaStream | null = null;
        let audioContext: AudioContext | null = null;
        let analyser: AnalyserNode | null = null;
        let mediaRecorder: MediaRecorder | null = null;
        let recordedChunks: Blob[] = [];
        let vadFrame = 0;
        let currentTtsUrl: string | null = null;

        function setOrbState(state: 'idle' | 'listening' | 'speaking') {
          orb?.classList.remove('talk-listening', 'talk-speaking');
          if (state === 'listening') orb?.classList.add('talk-listening');
          if (state === 'speaking') orb?.classList.add('talk-speaking');
        }

        function ensureVoicesLoaded(): Promise<void> {
          return new Promise((resolve) => {
            if (window.speechSynthesis.getVoices().length) {
              resolve();
              return;
            }
            const onVoices = () => {
              window.speechSynthesis.removeEventListener('voiceschanged', onVoices);
              resolve();
            };
            window.speechSynthesis.addEventListener('voiceschanged', onVoices);
            window.setTimeout(resolve, 1000);
          });
        }

        function pickIndianVoice(lang: string): SpeechSynthesisVoice | null {
          const voices = window.speechSynthesis.getVoices();
          if (voices.length === 0) return null;
          const exact = voices.filter((v) => v.lang.toLowerCase() === lang.toLowerCase());
          const langPrefix = lang.split('-')[0].toLowerCase();
          // Exact locale (e.g. en-IN) is rarely installed outside India-region OSes.
          // Fall back to any voice for the same language, then to any voice at all,
          // so we never force a lang with zero matching voices (browsers can then
          // silently produce no audio and never fire onend/onerror, hanging the call).
          const sameLanguage = exact.length ? exact : voices.filter((v) => v.lang.toLowerCase().startsWith(langPrefix));
          const pool = sameLanguage.length ? sameLanguage : voices;
          const male = pool.find((v) => /male|prabhat|ravi|hemant|rishi/i.test(v.name));
          return male || pool[0];
        }

        async function speakWithBrowser(text: string, onEnd: () => void) {
          await ensureVoicesLoaded();
          const targetLang = (navigator.language || 'en-IN').toLowerCase().startsWith('ta') ? 'ta-IN' : 'en-IN';
          const voice = pickIndianVoice(targetLang);
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = voice?.lang || targetLang;
          if (voice) utterance.voice = voice;

          let finished = false;
          const finish = () => {
            if (finished) return;
            finished = true;
            window.clearTimeout(safetyTimer);
            onEnd();
          };
          utterance.onend = finish;
          utterance.onerror = finish;

          // Some browsers never fire onend/onerror for an unsupported voice/lang
          // combination, which would otherwise hang the call forever with no audio.
          const safetyTimer = window.setTimeout(finish, Math.max(4000, text.length * 90));

          window.speechSynthesis.cancel();
          window.setTimeout(() => window.speechSynthesis.speak(utterance), 50);
        }

        async function speak(text: string, onEnd: () => void) {
          setOrbState('speaking');
          setStatus('Gokul AI is speaking...');

          const lang = navigator.language || 'en-US';
          // <audio> elements bypass iOS's hardware ringer/silent switch (they're
          // "media playback", like a music app), whereas raw Web Audio API output
          // does not - it gets silenced by that switch. So we play through a real
          // <audio> element, but reuse the SAME element for every reply. A brand
          // new element's .play() outside a direct gesture is rejected on mobile
          // Safari; this one element was already unlocked with a synchronous,
          // gesture-linked play() at call start (see the click handler below),
          // and once one element is unlocked its later async plays keep working
          // for the rest of the call.
          if (lang.toLowerCase().startsWith('en') && audioEl) {
            try {
              const res = await fetchWithTimeout(
                '/api/speak',
                {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ text })
                },
                SPEAK_FETCH_TIMEOUT_MS
              );
              if (res.ok) {
                const blob = await res.blob();
                if (!callActive) return;

                const url = URL.createObjectURL(blob);
                const previousUrl = currentTtsUrl;
                currentTtsUrl = url;

                const cleanup = () => {
                  audioEl.removeEventListener('ended', cleanup);
                  audioEl.removeEventListener('error', cleanup);
                  URL.revokeObjectURL(url);
                  if (currentTtsUrl === url) currentTtsUrl = null;
                  onEnd();
                };
                audioEl.addEventListener('ended', cleanup, { once: true });
                audioEl.addEventListener('error', cleanup, { once: true });

                audioEl.muted = false;
                audioEl.src = url;
                await audioEl.play();
                if (previousUrl) URL.revokeObjectURL(previousUrl);
                return;
              }
            } catch {
              // timed out, aborted, or network error — fall through to browser voice
            }
          }

          speakWithBrowser(text, onEnd);
        }

        function pickRecorderMimeType(): string {
          const candidates = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
          for (const type of candidates) {
            if (MediaRecorder.isTypeSupported?.(type)) return type;
          }
          return '';
        }

        function stopVad() {
          if (vadFrame) cancelAnimationFrame(vadFrame);
          vadFrame = 0;
        }

        function startListeningTurn(restartAttemptsSoFar = 0) {
          if (!callActive || !stream || !audioContext || !analyser) return;

          const mimeType = pickRecorderMimeType();
          recordedChunks = [];
          mediaRecorder = mimeType ? new MediaRecorder(stream, { mimeType }) : new MediaRecorder(stream);

          mediaRecorder.addEventListener('dataavailable', (event) => {
            if (event.data.size > 0) recordedChunks.push(event.data);
          });

          let spokeOnce = false;
          let streakStart: number | null = null;
          let lastAbove: number | null = null;
          let silenceStart: number | null = null;
          let noiseFloor: number | null = null;
          const noiseSamples: number[] = [];
          const recordingStart = Date.now();
          const data = new Uint8Array(analyser.fftSize);
          let restartAttempts = restartAttemptsSoFar;

          mediaRecorder.addEventListener('stop', () => {
            stopVad();
            if (!callActive) return;

            if (!spokeOnce || recordedChunks.length === 0) {
              restartAttempts += 1;
              // After a few silent attempts (~15-20s with nothing detected), let the
              // visitor know we're still trying rather than leaving an unchanging
              // "Listening..." label that reads as stuck.
              if (restartAttempts >= 3) {
                setStatus('Still listening — try speaking a bit louder');
              }
              startListeningTurn(restartAttempts);
              return;
            }

            const blob = new Blob(recordedChunks, { type: mimeType || 'audio/webm' });
            void transcribeAndRespond(blob);
          });

          mediaRecorder.start();
          setOrbState('listening');
          if (restartAttemptsSoFar < 3) setStatus('Listening...');

          const tick = () => {
            if (!callActive || !analyser || mediaRecorder?.state !== 'recording') return;

            analyser.getByteTimeDomainData(data);
            let sumSquares = 0;
            for (let i = 0; i < data.length; i++) {
              const normalized = (data[i] - 128) / 128;
              sumSquares += normalized * normalized;
            }
            const rms = Math.sqrt(sumSquares / data.length);
            const now = Date.now();
            const elapsed = now - recordingStart;

            if (noiseFloor === null) {
              if (elapsed < NOISE_SAMPLE_MS) {
                noiseSamples.push(rms);
              } else {
                const avgNoise = noiseSamples.length
                  ? noiseSamples.reduce((sum, value) => sum + value, 0) / noiseSamples.length
                  : 0;
                noiseFloor = avgNoise;
              }
            }

            const speechThreshold = Math.max(SPEECH_RMS_MIN_THRESHOLD, (noiseFloor ?? 0) + SPEECH_MARGIN_ABOVE_NOISE);

            if (rms > speechThreshold) {
              lastAbove = now;
              if (streakStart === null) streakStart = now;
              if (!spokeOnce && now - streakStart >= MIN_SPEECH_MS) spokeOnce = true;
              silenceStart = null;
            } else {
              // Brief dips (natural gaps between syllables) don't reset the streak,
              // only a real pause longer than SPEECH_GAP_TOLERANCE_MS does.
              if (streakStart !== null && lastAbove !== null && now - lastAbove > SPEECH_GAP_TOLERANCE_MS) {
                streakStart = null;
              }
              if (spokeOnce) {
                if (silenceStart === null) silenceStart = now;
                else if (now - silenceStart > SILENCE_MS) {
                  mediaRecorder?.stop();
                  return;
                }
              } else if (elapsed > NO_SPEECH_TIMEOUT_MS) {
                mediaRecorder?.stop();
                return;
              }
            }

            if (now - recordingStart > MAX_RECORD_MS) {
              mediaRecorder?.stop();
              return;
            }

            vadFrame = requestAnimationFrame(tick);
          };

          vadFrame = requestAnimationFrame(tick);
        }

        async function transcribeAndRespond(blob: Blob) {
          setOrbState('idle');
          setStatus('Thinking...');

          try {
            const form = new FormData();
            form.set('file', blob, 'clip.webm');
            const transcribeRes = await fetchWithTimeout(
              '/api/transcribe',
              { method: 'POST', body: form },
              TRANSCRIBE_TIMEOUT_MS
            );
            const transcribeData = await transcribeRes.json();
            if (!callActive) return;

            const transcript = typeof transcribeData.transcript === 'string' ? transcribeData.transcript.trim() : '';
            if (!transcript || looksHallucinated(transcript)) {
              startListeningTurn();
              return;
            }

            history.push({ role: 'user', content: transcript });

            const res = await fetchWithTimeout(
              '/api/chat',
              {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ messages: history, mode: 'voice' })
              },
              CHAT_TIMEOUT_MS
            );
            const data = await res.json();
            if (!callActive) return;

            if (!res.ok) {
              const errorReply = data.error || 'Something went wrong. Please try again.';
              speak(errorReply, () => {
                if (callActive) startListeningTurn();
              });
              return;
            }

            history.push({ role: 'assistant', content: data.reply });
            speak(data.reply, () => {
              if (callActive) startListeningTurn();
            });
          } catch (err) {
            if (!callActive) return;
            const timedOut = err instanceof DOMException && err.name === 'AbortError';
            const message = timedOut
              ? 'That took a bit long over this connection — try asking again.'
              : 'Something went wrong connecting. Please try again.';
            speak(message, () => {
              if (callActive) startListeningTurn();
            });
          }
        }

        function endCall() {
          callActive = false;
          callBtn?.classList.remove('talk-active');
          callBtn?.setAttribute('aria-label', 'Start call');
          setOrbState('idle');
          setStatus('Tap to start talking');

          stopVad();
          window.speechSynthesis.cancel();
          if (audioEl) {
            try {
              audioEl.pause();
            } catch {
              // ignore
            }
          }
          if (currentTtsUrl) {
            URL.revokeObjectURL(currentTtsUrl);
            currentTtsUrl = null;
          }

          try {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
          } catch {
            // ignore
          }
          mediaRecorder = null;

          stream?.getTracks().forEach((track) => track.stop());
          stream = null;
          audioContext?.close();
          audioContext = null;
          analyser = null;
        }

        callBtn?.addEventListener('click', async () => {
          if (callActive) {
            endCall();
            return;
          }

          // iOS Safari (and several Android WebViews) only let an AudioContext resume
          // out of suspended state when that call is still inside the original click's
          // gesture. Awaiting getUserMedia first breaks that chain and leaves the
          // context permanently suspended, so the volume analyser reads silence forever
          // and the call never detects speech. Create + resume it synchronously first.
          audioContext = new AudioContext();
          if (audioContext.state === 'suspended') {
            try {
              await audioContext.resume();
            } catch {
              // ignore
            }
          }
          try {
            window.speechSynthesis.speak(new SpeechSynthesisUtterance(''));
          } catch {
            // ignore
          }

          // Unlock the reusable <audio> element used for Gokul AI's voice: play a
          // silent clip synchronously within this click so mobile Safari treats
          // this element as gesture-authorized, then every later async play() on
          // it (once the actual reply comes back from Groq) keeps working without
          // needing its own gesture.
          if (audioEl) {
            try {
              const unlockUrl = createSilentAudioUrl();
              audioEl.src = unlockUrl;
              await audioEl.play();
              audioEl.pause();
              audioEl.currentTime = 0;
              URL.revokeObjectURL(unlockUrl);
            } catch {
              // ignore — speak() will fall back to browser voice if this didn't take
            }
          }

          try {
            stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          } catch {
            setStatus('Microphone permission denied.');
            audioContext?.close();
            audioContext = null;
            return;
          }

          analyser = audioContext.createAnalyser();
          analyser.fftSize = 1024;
          audioContext.createMediaStreamSource(stream).connect(analyser);

          callActive = true;
          callBtn.classList.add('talk-active');
          callBtn.setAttribute('aria-label', 'End call');
          startListeningTurn();
        });
      }
    </script>
  </body>
</html>
