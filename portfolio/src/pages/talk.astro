---
import '../styles/global.css';
import { profile } from '../data/experience';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/Gokulasigamani_favicon.png" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Talk to Gokul AI</title>
    <meta name="description" content={`Have a live voice conversation with Gokul AI, ${profile.name}'s AI assistant.`} />
  </head>
  <body class="relative flex min-h-[100dvh] flex-col items-center justify-center overflow-hidden bg-[#14100F] text-white">
    <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 bg-[#E3A17E] opacity-20 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-16 h-80 w-80 bg-[#8A6FB0] opacity-20 blur-3xl"></div>

    <a
      href="/"
      aria-label="Back to site"
      class="absolute left-4 z-10 flex h-10 w-10 items-center justify-center border border-white/15 text-white/60 transition-colors hover:border-white/40 hover:text-white"
      style="top: max(1rem, env(safe-area-inset-top, 0px));"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 6l-6 6 6 6" />
      </svg>
    </a>

    <div class="relative z-10 flex flex-col items-center gap-6 px-6 text-center">
      <div
        id="talk-orb"
        class="relative flex h-32 w-32 items-center justify-center border border-white/20 bg-white/5 font-heading text-3xl font-semibold text-[#E3A17E] backdrop-blur-sm sm:h-40 sm:w-40"
      >
        G
      </div>

      <div>
        <p class="font-heading text-lg font-medium text-white">Gokul AI</p>
        <p id="talk-status" class="mt-1 font-body text-sm text-white/60">Tap the call button to start talking</p>
      </div>

      <button
        id="talk-call"
        type="button"
        aria-label="Start call"
        class="mt-4 flex h-16 w-16 items-center justify-center border border-white/20 bg-emerald-500/90 text-white shadow-lg transition-colors hover:bg-emerald-500"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.85 1 1 0 0 1 .9 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.1a1 1 0 0 1 1 .9 11 11 0 0 0 .85 3.4 1 1 0 0 1-.24 1L6.6 10.8Z" />
        </svg>
      </button>

      <p id="talk-fallback" hidden class="max-w-xs font-body text-xs text-white/50">
        Voice calls need a browser that supports speech recognition, like Chrome or Edge. Try opening this page there.
      </p>
    </div>

    <style>
      @property --talk-orb-angle {
        syntax: '<angle>';
        initial-value: 0deg;
        inherits: false;
      }

      #talk-orb {
        --talk-orb-angle: 0deg;
      }

      #talk-orb::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        padding: 3px;
        background: conic-gradient(from var(--talk-orb-angle), #e3a17e, #c9a8c4, #8a6fb0, #e3a17e);
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        animation: talk-orb-rotate 4s linear infinite;
      }

      @keyframes talk-orb-rotate {
        to {
          --talk-orb-angle: 360deg;
        }
      }

      #talk-orb.talk-listening,
      #talk-orb.talk-speaking {
        animation: talk-orb-rotate 4s linear infinite, talk-pulse 1.1s ease-in-out infinite;
      }

      @keyframes talk-pulse {
        0%,
        100% {
          box-shadow: 0 0 0 0 rgba(227, 161, 126, 0.5);
        }
        50% {
          box-shadow: 0 0 0 16px rgba(227, 161, 126, 0);
        }
      }

      #talk-call.talk-active {
        background-color: rgba(239, 68, 68, 0.9);
      }

      @media (prefers-reduced-motion: reduce) {
        #talk-orb::before,
        #talk-orb.talk-listening,
        #talk-orb.talk-speaking {
          animation: none;
        }
      }
    </style>

    <script>
      type ChatMessage = { role: 'user' | 'assistant'; content: string };

      const orb = document.getElementById('talk-orb');
      const statusEl = document.getElementById('talk-status');
      const callBtn = document.getElementById('talk-call');
      const fallbackEl = document.getElementById('talk-fallback');

      const history: ChatMessage[] = [];
      let callActive = false;

      const SPEECH_RMS_THRESHOLD = 0.02;
      const MIN_SPEECH_MS = 300;
      const SPEECH_GAP_TOLERANCE_MS = 200;
      const SILENCE_MS = 700;
      const MAX_RECORD_MS = 20000;

      // Groq Whisper hallucinates short stock phrases on silence/noise-only audio
      // (e.g. it transcribes true silence as "Thank you."). Filter those out instead
      // of treating them as a real question.
      const HALLUCINATION_PATTERNS = [
        /^thanks?( you)?[.!]?$/i,
        /^thank you for watching[.!]?$/i,
        /^thanks for watching[.!]?$/i,
        /^please (subscribe|like and subscribe)[.!]?$/i,
        /^(bye|goodbye|see you)[.!]?$/i,
        /^[.,!?\s]*$/
      ];

      function looksHallucinated(transcript: string): boolean {
        const text = transcript.trim();
        if (!text) return true;
        return HALLUCINATION_PATTERNS.some((pattern) => pattern.test(text));
      }

      const supportsCall =
        Boolean(navigator.mediaDevices?.getUserMedia) && typeof MediaRecorder !== 'undefined';

      function setStatus(text: string) {
        if (statusEl) statusEl.textContent = text;
      }

      if (!supportsCall) {
        callBtn?.setAttribute('disabled', 'true');
        callBtn?.classList.add('opacity-40', 'cursor-not-allowed');
        fallbackEl?.removeAttribute('hidden');
        setStatus('Voice calls are not supported in this browser.');
      } else {
        let stream: MediaStream | null = null;
        let audioContext: AudioContext | null = null;
        let analyser: AnalyserNode | null = null;
        let mediaRecorder: MediaRecorder | null = null;
        let recordedChunks: Blob[] = [];
        let vadFrame = 0;
        let currentAudio: HTMLAudioElement | null = null;

        function setOrbState(state: 'idle' | 'listening' | 'speaking') {
          orb?.classList.remove('talk-listening', 'talk-speaking');
          if (state === 'listening') orb?.classList.add('talk-listening');
          if (state === 'speaking') orb?.classList.add('talk-speaking');
        }

        function ensureVoicesLoaded(): Promise<void> {
          return new Promise((resolve) => {
            if (window.speechSynthesis.getVoices().length) {
              resolve();
              return;
            }
            const onVoices = () => {
              window.speechSynthesis.removeEventListener('voiceschanged', onVoices);
              resolve();
            };
            window.speechSynthesis.addEventListener('voiceschanged', onVoices);
            window.setTimeout(resolve, 1000);
          });
        }

        function pickIndianVoice(lang: string): SpeechSynthesisVoice | null {
          const voices = window.speechSynthesis.getVoices();
          const matches = voices.filter((v) => v.lang.toLowerCase() === lang.toLowerCase());
          if (matches.length === 0) return null;
          const male = matches.find((v) => /male|prabhat|ravi|hemant|rishi/i.test(v.name));
          return male || matches[0];
        }

        async function speakWithBrowser(text: string, onEnd: () => void) {
          await ensureVoicesLoaded();
          const targetLang = (navigator.language || 'en-IN').toLowerCase().startsWith('ta') ? 'ta-IN' : 'en-IN';
          const voice = pickIndianVoice(targetLang);
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = voice?.lang || targetLang;
          if (voice) utterance.voice = voice;
          utterance.onend = onEnd;
          utterance.onerror = onEnd;
          window.speechSynthesis.cancel();
          window.setTimeout(() => window.speechSynthesis.speak(utterance), 50);
        }

        async function speak(text: string, onEnd: () => void) {
          setOrbState('speaking');
          setStatus('Gokul AI is speaking...');

          const lang = navigator.language || 'en-US';
          if (lang.toLowerCase().startsWith('en')) {
            try {
              const res = await fetch('/api/speak', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
              });
              if (res.ok) {
                const blob = await res.blob();
                const url = URL.createObjectURL(blob);
                currentAudio?.pause();
                const audio = new Audio(url);
                currentAudio = audio;
                const cleanup = () => {
                  URL.revokeObjectURL(url);
                  if (currentAudio === audio) currentAudio = null;
                  onEnd();
                };
                audio.addEventListener('ended', cleanup);
                audio.addEventListener('error', cleanup);
                await audio.play();
                return;
              }
            } catch {
              // fall through to browser voice
            }
          }

          speakWithBrowser(text, onEnd);
        }

        function pickRecorderMimeType(): string {
          const candidates = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
          for (const type of candidates) {
            if (MediaRecorder.isTypeSupported?.(type)) return type;
          }
          return '';
        }

        function stopVad() {
          if (vadFrame) cancelAnimationFrame(vadFrame);
          vadFrame = 0;
        }

        function startListeningTurn() {
          if (!callActive || !stream || !audioContext || !analyser) return;

          const mimeType = pickRecorderMimeType();
          recordedChunks = [];
          mediaRecorder = mimeType ? new MediaRecorder(stream, { mimeType }) : new MediaRecorder(stream);

          mediaRecorder.addEventListener('dataavailable', (event) => {
            if (event.data.size > 0) recordedChunks.push(event.data);
          });

          let spokeOnce = false;
          let streakStart: number | null = null;
          let lastAbove: number | null = null;
          let silenceStart: number | null = null;
          const recordingStart = Date.now();
          const data = new Uint8Array(analyser.fftSize);

          mediaRecorder.addEventListener('stop', () => {
            stopVad();
            if (!callActive) return;

            if (!spokeOnce || recordedChunks.length === 0) {
              startListeningTurn();
              return;
            }

            const blob = new Blob(recordedChunks, { type: mimeType || 'audio/webm' });
            void transcribeAndRespond(blob);
          });

          mediaRecorder.start();
          setOrbState('listening');
          setStatus('Listening...');

          const tick = () => {
            if (!callActive || !analyser || mediaRecorder?.state !== 'recording') return;

            analyser.getByteTimeDomainData(data);
            let sumSquares = 0;
            for (let i = 0; i < data.length; i++) {
              const normalized = (data[i] - 128) / 128;
              sumSquares += normalized * normalized;
            }
            const rms = Math.sqrt(sumSquares / data.length);
            const now = Date.now();

            if (rms > SPEECH_RMS_THRESHOLD) {
              lastAbove = now;
              if (streakStart === null) streakStart = now;
              if (!spokeOnce && now - streakStart >= MIN_SPEECH_MS) spokeOnce = true;
              silenceStart = null;
            } else {
              // Brief dips (natural gaps between syllables) don't reset the streak,
              // only a real pause longer than SPEECH_GAP_TOLERANCE_MS does.
              if (streakStart !== null && lastAbove !== null && now - lastAbove > SPEECH_GAP_TOLERANCE_MS) {
                streakStart = null;
              }
              if (spokeOnce) {
                if (silenceStart === null) silenceStart = now;
                else if (now - silenceStart > SILENCE_MS) {
                  mediaRecorder?.stop();
                  return;
                }
              }
            }

            if (now - recordingStart > MAX_RECORD_MS) {
              mediaRecorder?.stop();
              return;
            }

            vadFrame = requestAnimationFrame(tick);
          };

          vadFrame = requestAnimationFrame(tick);
        }

        async function transcribeAndRespond(blob: Blob) {
          setOrbState('idle');
          setStatus('Thinking...');

          try {
            const form = new FormData();
            form.set('file', blob, 'clip.webm');
            const transcribeRes = await fetch('/api/transcribe', { method: 'POST', body: form });
            const transcribeData = await transcribeRes.json();
            if (!callActive) return;

            const transcript = typeof transcribeData.transcript === 'string' ? transcribeData.transcript.trim() : '';
            if (!transcript || looksHallucinated(transcript)) {
              startListeningTurn();
              return;
            }

            history.push({ role: 'user', content: transcript });

            const res = await fetch('/api/chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ messages: history, mode: 'voice' })
            });
            const data = await res.json();
            if (!callActive) return;

            if (!res.ok) {
              const errorReply = data.error || 'Something went wrong. Please try again.';
              speak(errorReply, () => {
                if (callActive) startListeningTurn();
              });
              return;
            }

            history.push({ role: 'assistant', content: data.reply });
            speak(data.reply, () => {
              if (callActive) startListeningTurn();
            });
          } catch {
            if (!callActive) return;
            speak('Something went wrong connecting. Please try again.', () => {
              if (callActive) startListeningTurn();
            });
          }
        }

        function endCall() {
          callActive = false;
          callBtn?.classList.remove('talk-active');
          callBtn?.setAttribute('aria-label', 'Start call');
          setOrbState('idle');
          setStatus('Tap the call button to start talking');

          stopVad();
          window.speechSynthesis.cancel();
          currentAudio?.pause();
          currentAudio = null;

          try {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
          } catch {
            // ignore
          }
          mediaRecorder = null;

          stream?.getTracks().forEach((track) => track.stop());
          stream = null;
          audioContext?.close();
          audioContext = null;
          analyser = null;
        }

        callBtn?.addEventListener('click', async () => {
          if (callActive) {
            endCall();
            return;
          }

          try {
            stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          } catch {
            setStatus('Microphone permission denied.');
            return;
          }

          audioContext = new AudioContext();
          if (audioContext.state === 'suspended') {
            try {
              await audioContext.resume();
            } catch {
              // ignore
            }
          }
          analyser = audioContext.createAnalyser();
          analyser.fftSize = 1024;
          audioContext.createMediaStreamSource(stream).connect(analyser);

          callActive = true;
          callBtn.classList.add('talk-active');
          callBtn.setAttribute('aria-label', 'End call');
          try {
            window.speechSynthesis.speak(new SpeechSynthesisUtterance(''));
          } catch {
            // ignore
          }
          startListeningTurn();
        });
      }
    </script>
  </body>
</html>
