---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { isAuthenticated } from '../../lib/auth';

if (!isAuthenticated(Astro.cookies)) {
	return Astro.redirect('/dashboard');
}
---

<Layout title="New Post | Dashboard" description="Create a new blog post.">
	<section class="mx-auto max-w-[760px] px-4 py-16 sm:px-8">
		<a href="/dashboard" class="font-body text-sm text-neutral-500 transition-colors hover:text-neutral-900">← Back to dashboard</a>
		<h1 class="mt-4 font-heading text-2xl font-medium text-neutral-900">New post</h1>

		<form id="post-form" class="mt-8 flex flex-col gap-5">
			<div>
				<label for="title" class="font-body text-xs font-medium text-neutral-500">Title</label>
				<input id="title" type="text" name="title" required class="mt-1.5 w-full border border-neutral-200 px-3 py-2.5 font-body text-sm text-neutral-900 focus:border-neutral-400 focus:outline-none" />
			</div>
			<div>
				<label for="description" class="font-body text-xs font-medium text-neutral-500">Description</label>
				<textarea id="description" name="description" required rows="2" class="mt-1.5 w-full border border-neutral-200 px-3 py-2.5 font-body text-sm text-neutral-900 focus:border-neutral-400 focus:outline-none"></textarea>
			</div>
			<div>
				<label for="coverImage" class="font-body text-xs font-medium text-neutral-500">Cover image URL</label>
				<input id="coverImage" type="text" name="coverImage" required placeholder="/images/cover.jpg or https://..." class="mt-1.5 w-full border border-neutral-200 px-3 py-2.5 font-body text-sm text-neutral-900 focus:border-neutral-400 focus:outline-none" />
			</div>
			<div>
				<label for="tags" class="font-body text-xs font-medium text-neutral-500">Tags (comma-separated)</label>
				<input id="tags" type="text" name="tags" placeholder="AI, Full Stack" class="mt-1.5 w-full border border-neutral-200 px-3 py-2.5 font-body text-sm text-neutral-900 focus:border-neutral-400 focus:outline-none" />
			</div>
			<div>
				<label for="body" class="font-body text-xs font-medium text-neutral-500">Body (Markdown)</label>
				<textarea id="body" name="body" required rows="16" class="mt-1.5 w-full border border-neutral-200 px-3 py-2.5 font-body text-sm text-neutral-900 focus:border-neutral-400 focus:outline-none"></textarea>
			</div>
			<label class="flex items-center gap-2 font-body text-sm text-neutral-700">
				<input id="published" type="checkbox" name="published" />
				Publish immediately
			</label>

			<div class="flex items-center gap-4">
				<button type="submit" class="bg-neutral-900 px-5 py-2.5 font-body text-sm font-medium text-white transition-colors hover:bg-neutral-700">
					Save post
				</button>
				<p id="form-error" class="hidden font-body text-xs text-red-600"></p>
			</div>
		</form>
	</section>
</Layout>

<script>
  const form = document.getElementById('post-form') as HTMLFormElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const payload = {
      title: formData.get('title'),
      description: formData.get('description'),
      coverImage: formData.get('coverImage'),
      bodyMarkdown: formData.get('body'),
      tags: String(formData.get('tags') || '')
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean),
      published: formData.get('published') === 'on'
    };

    const res = await fetch('/api/admin/posts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const errorEl = document.getElementById('form-error');
    if (res.ok) {
      window.location.href = '/dashboard';
    } else {
      const data = await res.json().catch(() => ({}));
      if (errorEl) {
        errorEl.textContent = data.error || 'Something went wrong.';
        errorEl.classList.remove('hidden');
      }
    }
  });
</script>
