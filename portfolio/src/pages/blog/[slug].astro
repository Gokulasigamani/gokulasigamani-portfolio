---
export const prerender = false;

import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import { getPostBySlug } from '../../lib/db';
import { estimateReadingTime, formatPostDate } from '../../utils/reading-time';

const slug = Astro.params.slug;
const post = slug ? await getPostBySlug(slug) : null;

if (!post) {
	return Astro.redirect('/blog');
}

const contentHtml = marked.parse(post.body, { async: false }) as string;
const readingTime = estimateReadingTime(post.body);
const publishDate = new Date(post.published_at ?? post.created_at);
const shareUrl = new URL(`/blog/${post.slug}`, Astro.site).toString();
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
---

<Layout
	title={`${post.title} | Gokulasigamani N`}
	description={post.description}
	ogImage={post.cover_image}
	ogType="article"
>
	<article class="mx-auto max-w-[820px] px-4 py-16 sm:px-8 sm:py-20">
		<a href="/blog" class="inline-flex items-center gap-1.5 font-body text-sm text-neutral-500 transition-colors hover:text-neutral-900">
			<span aria-hidden="true">←</span>
			Back to blog
		</a>

		<p class="mt-8 font-body text-[11px] font-medium tracking-[0.15em] text-neutral-400">
			{formatPostDate(publishDate)} · {readingTime} min read
		</p>
		<h1 class="mt-3 font-heading text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.1] text-neutral-900">
			{post.title}
		</h1>

		<div class="mt-4 flex flex-wrap gap-2">
			{post.tags.map((tag) => (
				<span class="border border-neutral-200 px-2.5 py-1 font-body text-[11px] font-medium text-neutral-600">
					{tag}
				</span>
			))}
		</div>

		<div class="mt-8 aspect-[16/9] w-full overflow-hidden border border-neutral-200">
			<img src={post.cover_image} alt={post.title} class="h-full w-full object-cover" />
		</div>

		<div class="post-content mt-10" set:html={contentHtml} />

		<div class="mt-12 flex flex-col gap-4 border-t border-neutral-200 pt-8 sm:flex-row sm:items-center sm:justify-between">
			<a href="/blog" class="font-body text-sm font-medium text-neutral-600 transition-colors hover:text-neutral-900">
				← Back to blog
			</a>
			<a
				href={linkedInShareUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 border border-neutral-900 bg-neutral-900 px-5 py-2.5 font-body text-sm font-medium text-white transition-colors hover:bg-neutral-700"
			>
				Share on LinkedIn
				<span aria-hidden="true">↗</span>
			</a>
		</div>
	</article>
</Layout>

<style is:global>
  .post-content {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #404040;
  }

  .post-content > * + * {
    margin-top: 1.25em;
  }

  .post-content h2 {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
    color: #171717;
    margin-top: 2em;
  }

  .post-content h3 {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 500;
    color: #171717;
    margin-top: 1.75em;
  }

  .post-content a {
    color: #171717;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #a3a3a3;
  }

  .post-content a:hover {
    text-decoration-color: #171717;
  }

  .post-content ul,
  .post-content ol {
    padding-left: 1.25em;
  }

  .post-content ul {
    list-style: disc;
  }

  .post-content ol {
    list-style: decimal;
  }

  .post-content li + li {
    margin-top: 0.5em;
  }

  .post-content strong {
    font-weight: 600;
    color: #171717;
  }

  .post-content code {
    font-family: monospace;
    font-size: 0.875em;
    background: #f5f5f5;
    padding: 0.15em 0.4em;
  }

  .post-content blockquote {
    border-left: 2px solid #d4d4d4;
    padding-left: 1em;
    color: #525252;
    font-style: italic;
  }
</style>
